{
  "name": "cloudlabs-workshop-operations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "capture:submission": "node scripts/capture-submission.mjs",
    "eval:ai": "node --experimental-strip-types scripts/eval-ai.mjs"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
