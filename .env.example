# Optional API bind port.
API_PORT=3001

# Optional comma-separated browser origins. Defaults to the local Vite origins.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional AI filter provider: rules, gemini, or ollama.
AI_FILTER_PROVIDER=rules
AI_FILTER_MODEL=gemini-2.0-flash-lite
AI_FILTER_BASE_URL=http://127.0.0.1:11434
AI_FILTER_API_KEY=
AI_FILTER_TIMEOUT_MS=3000
AI_FILTER_COOLDOWN_MS=30000
AI_FILTER_FAILURE_THRESHOLD=3
